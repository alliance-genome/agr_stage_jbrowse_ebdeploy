option_settings:
  aws:ec2:vpc:
    AssociatePublicIpAddress: false
# Instance subnets (private): us-east-1a + us-east-1b only, matching ELBSubnets.
# Two AZs is the ALB minimum; each extra AZ adds a billed public IPv4 address
# on the load balancer. Applied live 2026-10-08.
    Subnets:
     - subnet-0d4703177afb1797d
     - subnet-04262fc338f638054
# Load balancer subnets (public): us-east-1a + us-east-1b
    ELBSubnets:
     - subnet-3ebf4477
     - subnet-df7c7487
#     - subnet-0d4703177afb1797d
#     - subnet-04262fc338f638054
#     - subnet-04019d42d5c9e6fb9
#     - subnet-049778993fb504a7c
    VPCId: vpc-55522232
    ELBScheme: public
